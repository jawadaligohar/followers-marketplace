# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/surgeon?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Peakerr supplier (optional -- unmapped/unconfigured services queue for manual fulfillment)
PEAKERR_API_KEY=
PEAKERR_SANDBOX=false
# Optional additional SMM providers. Keys stay on the server.
JAP_API_KEY=
JAP_SANDBOX=false
TIKSTA_API_KEY=
TIKSTA_SANDBOX=false
# Your own separate Social Fetch-compatible service; never use a competitor's endpoint.
SOCIAL_FETCH_API_URL=
SOCIAL_FETCH_API_KEY=
SUPPORT_EMAIL=hello@surgeon.io
RESEND_API_KEY=
EMAIL_FROM=
# Public USD receiving instructions. Bank checkout stays hidden until configured.
BANK_TRANSFER_INSTRUCTIONS=

# Seed script (initial admin user)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# NOWPayments (Crypto Payments)
# Get keys at: https://nowpayments.io (Store Settings -> API keys)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Optional: set to "true" if using sandbox.nowpayments.io testing environment
NOWPAYMENTS_SANDBOX=false
